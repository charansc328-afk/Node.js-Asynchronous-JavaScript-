// Node.js timers methods used:
// setInterval() and clearInterval()

let remaining = 5;

console.log("Countdown started");

const timer = setInterval(() => {
    console.log(`Time left: ${remaining} seconds`);

    remaining--;

    if (remaining < 0) {
        clearInterval(timer);
        console.log("Countdown finished");
    }
}, 1000);
